{
  "name": "veille-techno-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test && playwright test --config playwright.ui.config.ts",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write .",
    "lint:check": "oxlint . && eslint .",
    "format:check": "prettier --check .",
    "test:unit:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check:e2e": "tsc --project e2e/tsconfig.json --noEmit",
    "check": "npm run format:check && npm run lint:check && npm run type-check && npm run type-check:e2e && npm run test:coverage && npm run build-only",
    "test:api": "playwright test --config playwright.api.config.ts",
    "test:api:real": "node scripts/test-api-real.mjs"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "@primeuix/themes": "^1.2.5",
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.20.0",
    "pinia": "^4.0.3",
    "primevue": "^4.5.5",
    "tailwindcss": "^4.3.3",
    "validator": "13.15.35",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@types/validator": "^13.15.10",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "msw": "2.15.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.20.0"
}
